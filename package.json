{
  "name": "aura-ai",
  "version": "1.0.0",
  "description": "Aura AI - Intelligent Assistant with Notion, Calendar & App Launcher",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.aura.ai",
    "productName": "Aura AI",
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "aura_server.js",
      ".env",
      "package.json"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fal-ai/client": "^1.11.0",
    "@google/genai": "^3.6.0",
    "@notionhq/client": "^5.31.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "lucide-react": "^1.16.0",
    "msedge-tts": "^2.1.1",
    "nodemailer": "^10.6.1",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.3"
  }
}
